# ===========================================================
# B2A-LAB-ARQUITETO-ERP — Variáveis de ambiente (.env.example)
# ===========================================================
# Copie para .env e preencha SOMENTE no ambiente seguro local.
# NUNCA commite .env — já está no .gitignore.
#
# Para preenchimento orientado, veja: CONFIGURACAO-CREDENCIAIS.md
# ===========================================================

# ---- Supabase (projeto NOVO de testes — NÃO usar projeto de produção B2A) ----
# URL do projeto Supabase de desenvolvimento/testes
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto-teste>.supabase.co

# Chave publishable (anona) — pode ficar no cliente
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.<preencher>

# Chave anona (fallback) — pode ficar no cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.<preencher>

# Chave service_role — SOMENTE servidor. NUNCA no cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.<preencher>

# ---- Google Gemini (API do agente IA /api/agent) ----
# Obter em: https://aistudio.google.com/apikey
GEMINI_API_KEY=<preencher>

# ---- Webhook de importação financeira ----
# IMPORTANTE: o workflow n8n foi DESATIVADO nesta cópia.
# Esta variável é mantida para preservar compatibilidade com o código,
# mas nenhum workflow ativo envia dados ao endpoint.
# Gere uma string aleatória forte (ex: openssl rand -hex 32)
N8N_IMPORT_API_KEY=<gerar-nova-string-aleatoria-forte>

# ---- OpenBot (não required para rodar ERP; apenas para o Arquiteto) ----
# Provider de IA usado pelo agente no OpenBot
OPENBOT_DEFAULT_PROVIDER=codex

# ---- Configurações de ambiente ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Verificação de origem (CSP) ----
# Domínios permitidos em headers CSP. Separar por espaço.
CSP_ALLOWED_ORIGINS=http://localhost:3000

# ===========================================================
# NOTAS:
#
# 1. TODAS as credenciais aqui são NOVAS — não reutilizar
#    credenciais antigas do ERP B2A em produção.
#
# 2. O projeto Supabase deve ser NOVO, criado especificamente
#    para este ambiente de testes. Ver CONFIGURACAO-CREDENCIAIS.md.
#
# 3. O workflow n8n foi DESATIVADO nesta cópia. A variável
#    N8N_IMPORT_API_KEY existe apenas para compatibilidade
#    de código. Ver RELATORIO-AUDITORIA-ERP.md.
#
# 4. Para rodar o ERP localmente:
#    cp .env.example .env
#    # preencha os valores
#    cd erp && npm install && npm run dev
# ===========================================================
