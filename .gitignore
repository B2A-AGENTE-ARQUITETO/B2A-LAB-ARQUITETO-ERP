# ========================
# B2A-LAB-ARQUITETO-ERP
# .gitignore — versão monorepo
# ========================

# ---- Node.js / Next.js (ERP) ----
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
.npm
.pnp.*
.yarn/

# ---- Bun (legacy ERP) ----
bun.lockb
.bun/

# ---- Variáveis de ambiente ----
.env
.env.local
.env.development
.env.production
.env.*.local
!.env.example

# ---- Vercel ----
.vercel/

# ---- Supabase ----
supabase/.branches/
supabase/.temp/
supabase/functions/_backend/

# ---- OpenBot / Arquiteto ----
architect/state/
architect/instances/
*.sandbox-local
.openbot/
.openbot-build/

# ---- Logs e caches ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*
.DS_Store
Thumbs.db

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.history/

# ---- Testes e coverage ----
coverage/
.nyc_output/
*.lcov
.playwright/

# ---- Build de testes do ERP ----
erp/.next/
erp/coverage/
erp/test-results/

# ---- Arquivos sensíveis NUNCA commitados ----
*.pem
*.key
*.crt
*.p12
secrets/
credentials/
*.local.json

# ---- Uploads temporários ----
uploads/
tmp/
